# `next dev` loads this automatically. Committed on purpose: these are the
# shared local defaults, and every NEXT_PUBLIC_* value is inlined into the
# client bundle anyway — none of them is a secret.
#
# Override anything here in .env.local, which is gitignored and always wins.

# rippit-api via `make local` in ../rippit-api
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Supabase stack (`supabase start` in ../rippit-api). The anon key is
# the standard local development key, not a real credential — take the current
# values from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
