# Base URL of the rippit-api backend the UI talks to.
# NEXT_PUBLIC_* vars are inlined at build time — set this in Vercel
# (Project → Settings → Environment Variables) and redeploy to change it.
# Local dev falls back to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=

# Supabase project (Auth only — data flows through the API).
# Dashboard → Settings → API. Local stack: URL http://127.0.0.1:54421 and the
# anon key from `supabase status` (run in rippit-api/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
